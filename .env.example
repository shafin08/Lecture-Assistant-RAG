# ============================================================
# Lecture Assistant RAG — Example Environment Variables
# ============================================================

# --- OPENAI_API_KEY ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- LangSmith ---
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=rag
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- JWT ---
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- DATABASE ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/lecture_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=lecture-rag


# --- App Config ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- CORS ---
CORS_ORIGIN = http://localhost:8501,http://localhost:3000
