# --- OPENAI ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- JWT ---
# Generate a secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=720

# --- DATABASE ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=lecture_rag
DATABASE_URL=postgresql://postgres:change_this_password@localhost:5432/lecture_rag

# --- App Config ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# --- CORS ---
CORS_ORIGIN=http://localhost:8501
