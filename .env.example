# ============================================================
# Anime RAG — Environment Variables
# ============================================================

# --- Required ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- LangSmith (for tracing & evals) ---
# Sign up free at https://smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=anime-rag
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- JWT ---
JWT_SECRET_KEY=your-random-secret-key-here
JWT_ALGORITHM=Algorithm
JWT_EXPIRATION_MINUTES=minutes

# Database
DATABASE_URL=DATABASE_URL here


# --- App Config ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=10            # chunks to retrieve before reranking
TOP_K_RERANK=5                # chunks to pass to LLM after reranking
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
